# Backend-only secrets. Never expose these as VITE_ variables.
DATABASE_URL=sqlite+aiosqlite:///./kalki_local.db
# Production: paste Neon/Aiven PostgreSQL URL into Render, never frontend.
OLOSTEP_API_KEY=
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash
OLOSTEP_MODE=replay
ALLOWED_ORIGINS=http://localhost:5173
# Optional; admits all Vercel tenants. Prefer explicit origins.
# ALLOWED_ORIGIN_REGEX=^https://.*\.vercel\.app$
